---
import Layout from '../layouts/Layout.astro';
import { directory } from '../data/site';
---
<Layout title="Domains and products | pruthvii.com">
  <main id="main" class="inner-main">
    <h1>Domains and products</h1>
    <p class="section-description">Sites I run, plus a place to browse my code.</p>
    <ul class="directory">{directory.map(item => {
      const external = item.href.startsWith('http');
      return <li>
        <p class="directory-type">{item.type}</p>
        <h2><a href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{item.name}{external ? ' ↗' : ''}</a></h2>
        <p>{item.description}</p>
        <a class="text-link" href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{item.label}{external ? ' ↗' : ' →'}</a>
      </li>;
    })}</ul>
    <a class="text-link" href="/#projects">← Back to projects</a>
  </main>
</Layout>
