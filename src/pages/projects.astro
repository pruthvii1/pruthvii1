---
import Layout from '../layouts/Layout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { domains, projects } from '../data/site';

const siteOrigin = new URL('https://pruthvii.com');
const isExternal = (href: string) => new URL(href, siteOrigin).origin !== siteOrigin.origin;
---
<Layout title="Projects | pruthvii.com" description="Domains, products, and experiments built by Pruthviraj.">
  <main id="main" class="inner-main">
    <section class="inner-section" aria-labelledby="domains-title">
      <h1 id="domains-title" class="listing-heading">Domains</h1>
      <ul class="listing-list">{domains.map(domain => {
        const external = isExternal(domain.href);
        return <li class="listing-row">
          <div class="listing-copy">
            <h3><a class="link-with-icon" href={domain.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{domain.name}{external && <ArrowIcon direction="external" />}</a></h3>
            <p>{domain.description}</p>
          </div>
        </li>;
      })}</ul>
    </section>

    <section class="inner-section" aria-labelledby="all-projects-title">
      <h2 id="all-projects-title" class="listing-heading">Projects</h2>
      <ul class="listing-list">{projects.map(project => {
        return <li class="listing-row">
          <div class="listing-copy">
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
          <div class="listing-actions">
            {project.link && <a class="code-link" href={project.link} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} live site`}>Site <ArrowIcon direction="external" /></a>}
            <a class="code-link" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} source code`}>Code <ArrowIcon direction="external" /></a>
          </div>
        </li>;
      })}</ul>
    </section>
  </main>
</Layout>
