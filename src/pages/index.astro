---
import Layout from '../layouts/Layout.astro';
import { archive } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const siteOrigin = new URL('https://pruthvii.com');
const isExternal = (href: string) => new URL(href, siteOrigin).origin !== siteOrigin.origin;
---
<Layout>
  <main id="main">
    <section id="about" class="about-section" aria-labelledby="intro-title">
      <h1 id="intro-title">Hey, I'm Pruthviraj.</h1>
      <p>I'm 18, based in Latur, India. I like making things that help people, and figuring things out along the way.</p>
      <p>Mostly products and small experiments. I also make videos for fun, and I'll be writing here soon.</p>
      <div class="social-links"><a href="https://github.com/pruthvii1" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://x.com/pruthvithinks" target="_blank" rel="noopener noreferrer">X ↗</a><a href="https://youtube.com/@pruthvii1" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
    </section>
    <section id="projects" class="home-section" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      <p class="section-description">A few older experiments. These are no longer maintained.</p>
      <ul class="project-list">{archive.map(project => {
        const projectHref = project.link || project.github;
        const projectIsExternal = isExternal(projectHref);
        return <li><div><h3><a href={projectHref} target={projectIsExternal ? '_blank' : undefined} rel={projectIsExternal ? 'noopener noreferrer' : undefined}>{project.name} {projectIsExternal && <span aria-hidden="true">↗</span>}</a></h3><p>{project.description}</p></div><a class="code-link" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} source code`}>Code ↗</a></li>;
      })}</ul>
      <a class="text-link" href="/domains/">More domains and products →</a>
    </section>
    <section id="writing" class="home-section" aria-labelledby="writing-title">
      <h2 id="writing-title">Blog</h2>
      {posts.length ? <div class="post-list">{posts.slice(0,3).map(post => <a class="post-row" href={`/blog/${post.id}/`}><h3>{post.data.title}</h3><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', {month:'short',day:'numeric',year:'numeric', timeZone:'UTC'})}</time><p>{post.data.description}</p></a>)}</div> : <p class="empty-note">Nothing published yet. I'll be sharing what I'm learning and working on here.</p>}
      <a class="text-link" href="/blog/">All blog posts →</a>
    </section>
  </main>
</Layout>
