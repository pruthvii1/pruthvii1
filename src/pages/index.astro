---
import Layout from '../layouts/Layout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { projects } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout>
  <main id="main">
    <section id="about" class="about-section" aria-labelledby="intro-title">
      <h1 id="intro-title">Hey, I'm Pruthviraj.</h1>
      <p>I like making things that help people, and figuring things out along the way.</p>
      <p>Mostly products and small experiments. I also make videos for fun, and I'll be writing here soon.</p>
      <div class="social-links"><a class="link-with-icon" href="https://github.com/pruthvii1" target="_blank" rel="noopener noreferrer">GitHub <ArrowIcon direction="external" /></a><a class="link-with-icon" href="https://x.com/pruthvithinks" target="_blank" rel="noopener noreferrer">X <ArrowIcon direction="external" /></a><a class="link-with-icon" href="https://youtube.com/@pruthvii1" target="_blank" rel="noopener noreferrer">YouTube <ArrowIcon direction="external" /></a></div>
    </section>
    <section id="projects" class="home-section" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      <p class="section-description">Products and experiments I've built.</p>
      <ul class="listing-list">{projects.map(project => {
        return <li class="listing-row"><div class="listing-copy"><h3>{project.name}</h3><p>{project.description}</p></div><div class="listing-actions">{project.link && <a class="code-link" href={project.link} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} live site`}>Site <ArrowIcon direction="external" /></a>}<a class="code-link" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} source code`}>Code <ArrowIcon direction="external" /></a></div></li>;
      })}</ul>
      <a class="text-link" href="/projects/">All domains and projects <ArrowIcon direction="right" /></a>
    </section>
    <section id="writing" class="home-section" aria-labelledby="writing-title">
      <h2 id="writing-title">Blog</h2>
      {posts.length ? <div class="post-list">{posts.slice(0,3).map(post => <a class="post-row" href={`/blog/${post.id}/`}><div class="post-copy"><h3>{post.data.title}</h3><p>{post.data.description}</p></div><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', {month:'short',day:'numeric',year:'numeric', timeZone:'UTC'})}</time></a>)}</div> : <p class="empty-note">Nothing published yet. I'll be sharing what I'm learning and working on here.</p>}
      <a class="text-link" href="/blog/">All blog posts <ArrowIcon direction="right" /></a>
    </section>
  </main>
</Layout>
