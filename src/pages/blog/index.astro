---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Blog | pruthvii.com" description="Writing by pruthvii about making products and learning along the way.">
  <main id="main" class="inner-main">
    <h1 data-reveal>Blog</h1>
    <p class="section-description" data-reveal>Things I'm learning as I build.</p>
    {posts.length ? <div class="post-list">{posts.map(post => <a class="post-row" href={`/blog/${post.id}/`} data-reveal><div class="post-copy"><h2>{post.data.title}</h2><p>{post.data.description}</p></div><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', {month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></a>)}</div> : <p class="empty-note" data-reveal>No posts yet. I'm getting started with this blog. Come back soon for the first one.</p>}
  </main>
</Layout>
