---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { title = 'Pruthviraj | pruthvii.com', description = 'Pruthviraj, a builder from Latur, India. Products, experiments, and writing.', } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="pruthvii.com home">pruthvii.com</a>
        <nav aria-label="Main navigation">
          <a href="/#about">About</a>
          <a href="/#projects">Projects</a>
          <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/domains/" aria-current={path.startsWith('/domains') ? 'page' : undefined}>Domains</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>Built by Pruthviraj, in <a href="https://www.google.com/maps/search/?api=1&query=18.420810750772624,76.57389488551998" target="_blank" rel="noopener noreferrer">Latur, India</a>.</p>
        <a href="https://x.com/pruthvithinks" target="_blank" rel="noopener noreferrer">Say hello ↗</a>
      </footer>
    </div>
    <script>
      const prepareExternalLinks = () => {
        for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
          const url = new URL(link.href, window.location.href);

          if (url.origin !== window.location.origin && ['http:', 'https:'].includes(url.protocol)) {
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.dataset.astroPrefetch = 'false';
          }
        }
      };

      prepareExternalLinks();
      document.addEventListener('astro:page-load', prepareExternalLinks);
    </script>
  </body>
</html>
