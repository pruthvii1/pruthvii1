---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ArrowIcon from '../components/ArrowIcon.astro';
import PostHog from '../components/PostHog.astro';
import sunIcon from '@tabler/icons/outline/sun.svg?raw';
import moonIcon from '@tabler/icons/outline/moon.svg?raw';
const { title = 'pruthvii | pruthvii.com', description = 'pruthvii, a builder from Latur, India. Products, experiments, and writing.', } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/great-vibes-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      document.documentElement.classList.add('has-js');
      try {
        const savedTheme = localStorage.getItem('theme');
        document.documentElement.dataset.theme = savedTheme === 'dark' ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <title>{title}</title>
    <PostHog />
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="pruthvii.com home">pruthvii.com</a>
        <div class="header-actions">
          <nav aria-label="Main navigation">
            <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
            <a href="/projects/" aria-current={path.startsWith('/projects') ? 'page' : undefined}>Projects</a>
            <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          </nav>
          <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Switch to dark theme" data-theme-toggle>
            <span class="theme-icon theme-icon-moon" aria-hidden="true" set:html={moonIcon} />
            <span class="theme-icon theme-icon-sun" aria-hidden="true" set:html={sunIcon} />
          </button>
        </div>
      </header>
      <slot />
      <footer class="site-footer" data-reveal>
        <p>Built by pruthvii, in <a href="https://www.google.com/maps/search/?api=1&query=18.420810750772624,76.57389488551998" target="_blank" rel="noopener noreferrer">Latur, India</a>.</p>
        <a class="link-with-icon" href="https://x.com/pruthvithinks" target="_blank" rel="noopener noreferrer">Say hello <ArrowIcon direction="external" /></a>
      </footer>
    </div>
    <script>
      type Theme = 'light' | 'dark';

      const applyTheme = (theme: Theme) => {
        document.documentElement.dataset.theme = theme;

        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
          const isDark = theme === 'dark';
          button.setAttribute('aria-checked', String(isDark));
          button.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        }
      };

      const prepareThemeToggle = () => {
        const theme: Theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        applyTheme(theme);

        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
          button.onclick = () => {
            const nextTheme: Theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme(nextTheme);

            try {
              localStorage.setItem('theme', nextTheme);
            } catch {
              // The selected theme still applies for the current page.
            }
          };
        }
      };

      const prepareExternalLinks = () => {
        for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
          const url = new URL(link.href, window.location.href);

          if (url.origin !== window.location.origin && ['http:', 'https:'].includes(url.protocol)) {
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.dataset.astroPrefetch = 'false';
          }
        }
      };

      const revealObserver = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? null
        : new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              entry.target.classList.add('is-visible');
              revealObserver?.unobserve(entry.target);
            }
          }, { rootMargin: '0px 0px -24px', threshold: 0.08 });

      const prepareReveals = () => {
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal], .prose > *');

        for (const target of targets) {
          target.dataset.reveal = '';

          if (!revealObserver) {
            target.classList.add('is-visible');
            continue;
          }

          revealObserver.observe(target);
        }
      };

      prepareThemeToggle();
      prepareExternalLinks();
      prepareReveals();
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      });
      document.addEventListener('astro:page-load', () => {
        prepareThemeToggle();
        prepareExternalLinks();
        prepareReveals();
      });
    </script>
  </body>
</html>
